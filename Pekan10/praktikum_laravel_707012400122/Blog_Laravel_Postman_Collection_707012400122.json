{
  "info": {
    "name": "Blog Laravel API (Modul 10 / 11)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token_budi", "value": "" },
    { "key": "token_andi", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Budi",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi Santoso\",\n  \"email\": \"budi@example.com\",\n  \"password\": \"praktikum123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/auth/register"
          }
        },
        {
          "name": "Login Budi",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"budi@example.com\",\n  \"password\": \"praktikum123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_budi}}", "type": "string" }] },
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_budi}}", "type": "string" }] },
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Get All Posts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/posts"
          }
        },
        {
          "name": "Get Single Post",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/posts/1"
          }
        },
        {
          "name": "Create Post (with File form-data)",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_budi}}", "type": "string" }] },
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Belajar Laravel REST API", "type": "text" },
                { "key": "content", "value": "Artikel pertama dengan lampiran file.", "type": "text" },
                { "key": "file", "type": "file", "src": "" }
              ]
            },
            "url": "{{base_url}}/api/posts"
          }
        },
        {
          "name": "Get Post File",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/posts/1/file"
          }
        },
        {
          "name": "Update Post (Method Spoofing + File)",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_budi}}", "type": "string" }] },
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "_method", "value": "PATCH", "type": "text" },
                { "key": "title", "value": "Judul Artikel Diperbarui", "type": "text" },
                { "key": "content", "value": "Isi artikel diperbarui.", "type": "text" },
                { "key": "file", "type": "file", "src": "" }
              ]
            },
            "url": "{{base_url}}/api/posts/1"
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_budi}}", "type": "string" }] },
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/posts/1"
          }
        }
      ]
    }
  ]
}
